# Arboles individuales
FORMULA_BASAL_AREA=(math.pi * ((dap_cm / 100.0) ** 2)) / 4.0
FORMULA_DIAMETRO_ALTURA_PECHO=dap_cm ** 2
FORMULA_VOLUMEN_TOTAL_CC=0.0006 + 0.3348 * ((dap_cm / 100.0) ** 2) * height_m
FORMULA_VOLUMEN_TOTAL_SC=-0.0021 + 0.3127 * ((dap_cm / 100.0) ** 2) * height_m
FORMULA_VOLUMEN_MADERABLE_CC=-0.0136 + 0.3247 * ((dap_cm / 100.0) ** 2) * height_m
FORMULA_VOLUMEN_MADERABLE_SC=-0.0193 + 0.3079 * ((dap_cm / 100.0) ** 2) * height_m
FORMULA_BIOMASA_AEREA_TOTAL=-0.0808 + 0.0206 * (dap_cm ** 2.337) * (height_m ** 0.614)
FORMULA_BIOMASA_RAIZ=biomasa_aerea_total * 0.263
FORMULA_BIOMASA_TOTAL=biomasa_aerea_total + biomasa_raiz

# Eto es para plantación
FORMULA_TAMANO_PARCELA=cantidad_arboles * dis_arboles_fila * dis_arboles_entre_fila
FORMULA_RADIO_PARCELA=math.sqrt(tamano_parcela / math.pi)

# Medición (relacionados a data por hectarea)
FORMULA_ARBOLES_HA=cantidad_arboles * 10000 / tamano_parcela
FORMULA_POR_HA=valor_total * 10000 / tamano_parcela
FORMULA_BIOMASA_HA=valor_total * 10000 / tamano_parcela / 1000

# Medición (calculos mpas puntuales)
FORMULA_BIOMASA_AEREA_TOTAL=-0.0808 + 0.0206 * (dap_cm ** 2.337) * (height_m ** 0.614)
FORMULA_BIOMASA_RAIZ=biomasa_aerea_total * 0.263
FORMULA_BIOMASA_TOTAL=biomasa_aerea_total + biomasa_raiz
FORMULA_CAPTACION_BOSQUE=biomasa_total_ha * 0.49
FORMULA_DIAS=edad * 365
FORMULA_INDICE_SITIO=(altura_dominante * (1 - math.exp(-0.14 * 10)) ** (1 / 0.67)) / ((1 - math.exp(-0.14 * edad)) ** (1 / 0.67))
FORMULA_CAPTACION_DIARIA=captacion_bosque / dias * 1000
FORMULA_EMISION_DIARIA=5
FORMULA_PUNTO_EQUILIBRIO=captacion_diaria / emision_diaria